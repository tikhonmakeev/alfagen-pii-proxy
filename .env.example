# Переменные окружения для cmd/piiproxy.
# Скопируйте в .env и заполните значения.

# Адрес основного API.
LISTEN_ADDR=127.0.0.1:8080
# Адрес для метрик Prometheus.
METRICS_ADDR=127.0.0.1:9090
# Пути к сертификату/ключу для HTTPS (если оба заданы — слушать через TLS).
TLS_CERT_FILE=
TLS_KEY_FILE=
# Путь к YAML с потребителями.
CONSUMERS_CONFIG=consumers.yaml
# id потребителя для безголового доступа (пусто = выключено).
PUBLIC_CONSUMER=
# TTL записей стора в секундах.
STATE_TTL_SECONDS=1800
# Лимит записей стора.
STATE_MAX_ENTRIES=400000
# Лимит памяти стора в мегабайтах.
STATE_MAX_MB=512
# Лимит одновременных обработок.
MAX_INFLIGHT=64

# Секретные ключи потребителей (пустые — заполните реальными).
LOADTEST_API_KEY=
DEMO_API_KEY=
ANALYTICS_API_KEY=